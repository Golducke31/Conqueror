{
  "name": "conqueror",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Conqueror - juego de conquista mundial por turnos, tablero 3D, modo local y online",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @conqueror/client dev",
    "dev:server": "pnpm --filter @conqueror/server dev",
    "build": "pnpm --filter @conqueror/client build",
    "preview": "pnpm --filter @conqueror/client preview",
    "typecheck": "pnpm -r --no-bail typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "map:fetch": "tsx scripts/fetch-map-data.ts",
    "map:build": "tsx scripts/build-map.ts",
    "map:validate": "tsx scripts/validate-map.ts",
    "map:balance": "tsx scripts/balance-report.ts",
    "map:all": "pnpm map:build && pnpm map:validate && pnpm map:balance",
    "map:preview": "tsx scripts/preview-map.ts",
    "smoke": "tsx scripts/smoke-client.ts",
    "smoke:match": "tsx scripts/smoke-match.ts"
  },
  "devDependencies": {
    "@conqueror/map-data": "workspace:*",
    "@conqueror/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "d3-geo": "^3.1.1",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
